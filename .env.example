# Core
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=.onrender.com

# Database (Render PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis for Django Channels (Render Redis connection string)
REDIS_URL=redis://default:password@host:6379

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://tu-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://tu-frontend.onrender.com

# App URLs
FRONTEND_MENU_BASE_URL=https://tu-frontend.onrender.com/order

# Media (persistent disk in Render)
MEDIA_ROOT=/var/data/media

# Optional security tuning
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Optional seed admin (for python manage.py seed_data --with-admin)
SEED_ADMIN_EMAIL=admin@nightcode.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DOCUMENT=1000000000
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=NightCode
